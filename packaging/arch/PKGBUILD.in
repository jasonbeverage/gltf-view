# Maintainer: Jason Beverage <jasonbeverage@gmail.com>
# Generated by .github/workflows/release.yml for each release (installs the prebuilt binary).
# Install on Arch / Omarchy: download PKGBUILD from the release page, then `makepkg -si`.
pkgname=gltf-view-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Fast glTF / GLB viewer with property inspector and animation playback"
arch=('x86_64')
url="https://github.com/jasonbeverage/gltf-view"
license=('MIT')
depends=('gcc-libs' 'glibc' 'fontconfig' 'freetype2' 'libxkbcommon' 'libxkbcommon-x11' 'libxcb' 'wayland' 'vulkan-icd-loader')
optdepends=('vulkan-driver: GPU rendering (mesa or your vendor driver)')
provides=('gltf-view')
conflicts=('gltf-view')
source=("gltf-view-$pkgver.tar.gz::$url/releases/download/v$pkgver/gltf-view-linux-x86_64.tar.gz")
sha256sums=('@SHA256@')

package() {
    cd gltf-view
    install -Dm755 gltf-view "$pkgdir/usr/bin/gltf-view"
    install -Dm644 gltf-view.desktop "$pkgdir/usr/share/applications/gltf-view.desktop"
    install -Dm644 gltf-view-mime.xml "$pkgdir/usr/share/mime/packages/gltf-view.xml"
    install -Dm644 gltf-view.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/gltf-view.png"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
